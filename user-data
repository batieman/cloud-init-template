#cloud-config

# Local demo credential. Replace this before using the template anywhere other
# than an isolated development VM.
password: password
chpasswd:
  expire: False

packages:
  - xubuntu-desktop-minimal

bootcmd:
  - [mkdir, -p, /mnt/share]

mounts:
  - [share0, /mnt/share, 9p, "trans=virtio,version=9p2000.L", "0", "0"]
